# Configuración de Firebase para Proyecto Murales
# Renombra este archivo a .env y completa con las credenciales de tu proyecto en Firebase Console

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-murales.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-murales
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-murales.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
